# Postgres connection string. In production, use a dedicated production
# database — do not point this at a shared dev/staging instance.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschlernen_dev?schema=public"

# Random secret used to sign session tokens. Generate a fresh one for
# production — never reuse a dev value. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"

# Canonical URL of the deployed app (no trailing slash), e.g.
# https://your-domain.com. Must match the real domain in production —
# NextAuth uses this to validate callback/redirect URLs.
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google AdSense. Ads stay disabled (component renders nothing)
# until both are set and the user has accepted cookies.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# Optional: Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Analytics
# stays disabled until set and the user has accepted cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL used to build the sitemap and canonical links, e.g.
# https://your-domain.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Optional: Resend API key for sending password-reset emails. Without it,
# the reset-request endpoint still responds successfully but skips the
# actual send (a warning is logged server-side). Get a key at
# https://resend.com/api-keys. Without a verified sending domain, mail
# only delivers to the address on your own Resend account — see README.
RESEND_API_KEY=
