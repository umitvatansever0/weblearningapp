generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UiLanguage {
  DE
  EN
  TR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  uiLanguage   UiLanguage @default(EN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
