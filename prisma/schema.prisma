generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UiLanguage {
  DE
  EN
  TR
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role       @default(USER)
  uiLanguage       UiLanguage @default(EN)
  streak           Int        @default(0)
  lastActivityDate DateTime?
  xp               Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  progress         UserProgress[]
  vocabCards       UserVocabCard[]
  badges           UserBadge[]
  resetTokens      PasswordResetToken[]
  blogPosts        BlogPost[]
  blogAnswers      BlogAnswer[]
  blogReports      BlogReport[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum LevelCode {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  MATCHING
  SENTENCE_ORDER
  SHORT_ANSWER
}

model Level {
  id    String    @id @default(cuid())
  code  LevelCode @unique
  order Int
  units Unit[]
}

model Unit {
  id      String  @id @default(cuid())
  levelId String
  level   Level   @relation(fields: [levelId], references: [id])
  order   Int
  slug    String?
  titleDe String
  titleEn String
  titleTr String
  lessons Lesson[]

  // Human-readable URL segment, unique within a level.
  @@unique([levelId, slug])
}

model Lesson {
  id            String  @id @default(cuid())
  unitId        String
  unit          Unit    @relation(fields: [unitId], references: [id])
  order         Int
  slug          String?
  grammarTopic  String
  explanationDe String
  explanationEn String
  explanationTr String
  exercises     Exercise[]
  progress      UserProgress[]
  vocabWords    VocabWord[]

  // Human-readable URL segment, unique within a unit; stable across locales.
  @@unique([unitId, slug])
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id])
  order         Int
  type          ExerciseType
  data          Json
  correctAnswer Json
  explanation   String
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id])
  completed     Boolean  @default(false)
  score         Int      @default(0)
  lastAttemptAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model VocabWord {
  id              String @id @default(cuid())
  lessonId        String
  lesson          Lesson @relation(fields: [lessonId], references: [id])
  word            String
  translationEn   String
  translationTr   String
  exampleSentence String
  cards           UserVocabCard[]
}

model UserVocabCard {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  vocabWordId    String
  vocabWord      VocabWord @relation(fields: [vocabWordId], references: [id])
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  dueDate        DateTime  @default(now())
  lastReviewedAt DateTime?

  @@unique([userId, vocabWordId])
}

model Badge {
  id      String @id @default(cuid())
  code    String @unique
  titleDe String
  titleEn String
  titleTr String
  users   UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// --- Community blog (Q&A) ---------------------------------------------------
// Members post questions/sharings (optionally with uploaded images/files) and
// answer each other. Content is published immediately; visitors can report it
// and admins hide or delete it from /admin/blog. Hidden content is excluded
// from every public query.

model BlogPost {
  id          String           @id @default(cuid())
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  hidden      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  answers     BlogAnswer[]
  attachments BlogAttachment[]
  reports     BlogReport[]

  @@index([hidden, createdAt])
  @@index([authorId, createdAt])
}

model BlogAnswer {
  id        String       @id @default(cuid())
  postId    String
  post      BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean      @default(false)
  createdAt DateTime     @default(now())
  reports   BlogReport[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

// A file in Vercel Blob that belongs to a post. `url` is the public blob URL;
// `pathname` is kept so the blob can be deleted together with its post.
model BlogAttachment {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url         String   @unique
  pathname    String
  contentType String
  size        Int
  fileName    String
  createdAt   DateTime @default(now())

  @@index([postId])
}

// Exactly one of postId / answerId is set. A member can report the same item
// only once (NULLs are distinct in Postgres unique indexes).
model BlogReport {
  id         String      @id @default(cuid())
  reporterId String
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       BlogPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     BlogAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, postId])
  @@unique([reporterId, answerId])
  @@index([resolvedAt])
}
